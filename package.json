{
  "name": "bc-lce",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Liko Club Extensions - horizontal login UI and club extensions for Bondage Club",
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "check:bc": "node scripts/check-bc-compat.mjs",
    "predev": "node scripts/verify-assets.mjs",
    "dev": "vite build && concurrently -k -n build,serve \"vite build --watch\" \"vite preview --port 5174\"",
    "prebuild": "node scripts/verify-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5174"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "concurrently": "^10.0.6",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "idb": "^8.0.4"
  }
}
